# Crackint Backend — copy to .env and adjust

# App
APP_NAME=Crackint Backend API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# NER model directory (folder containing bert_bilstm_crf_state.pt, ner_config.json, vocab.txt, etc.)
# Leave unset to use rule-based NAME/EMAIL only (no model). See RESUME_NER_SETUP.md.
RESUME_NER_LOAD_DIR=./model/resume_ner

# Job poster NER model directory (same layout: bert_bilstm_crf_state.pt, ner_config.json, tokenizer files)
# Leave unset to use resume NER for job descriptions.
JOB_POSTER_NER_LOAD_DIR=./model/job_poster_ner

# Upload limit for resume/job PDFs (MB)
MAX_UPLOAD_SIZE_MB=10
