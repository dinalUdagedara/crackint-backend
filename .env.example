# Crackint Backend — copy to .env and adjust

# App
APP_NAME=Crackint Backend API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# NER model directory (saved model, tokenizer, config from notebook)
# Leave unset to use stub extraction only
# RESUME_NER_LOAD_DIR=/path/to/resume_ner

# Upload limit for resume PDFs (MB)
MAX_UPLOAD_SIZE_MB=10
