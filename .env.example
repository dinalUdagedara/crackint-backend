# Crackint Backend — copy to .env and adjust

# App
APP_NAME=Crackint Backend API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# NER model directory (folder containing bert_bilstm_crf_state.pt, ner_config.json, vocab.txt, etc.)
# Leave unset to use rule-based NAME/EMAIL only (no model). See RESUME_NER_SETUP.md.
RESUME_NER_LOAD_DIR=./model/resume_ner

# Optional: if RESUME_NER_LOAD_DIR is not set or path does not exist, download from Google Drive at startup.
# Use folder ID ( .../folders/FOLDER_ID ) or file ID ( .../file/d/FILE_ID ) from your share link.
# Requires: poetry install --with download  or  pip install gdown
# RESUME_NER_GDRIVE_FOLDER_ID=1n3ErPwIo9fpLTuWzuBSG46JOMqlNpB_X
# RESUME_NER_GDRIVE_FILE_ID=your_file_id_if_you_uploaded_a_zip

# Job poster NER model directory (same layout: bert_bilstm_crf_state.pt, ner_config.json, tokenizer files)
# Leave unset to use resume NER for job descriptions.
JOB_POSTER_NER_LOAD_DIR=./model/job_poster_ner

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crackint_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password

# Upload limit for resume/job PDFs (MB)
MAX_UPLOAD_SIZE_MB=10

# Entity AI agents (optional validation/correction after NER)
# RESUME_ENTITY_AGENT_ENABLED=false
# JOB_ENTITY_AGENT_ENABLED=false
# OPENAI_API_KEY=sk-...

# Session Q&A agent: interview prep question generation + answer evaluation
# Requires OPENAI_API_KEY. Set to true to enable POST /sessions/{id}/next-question and evaluate-answer.
# SESSION_QA_AGENT_ENABLED=false
# SESSION_QA_AGENT_MODEL=gpt-4o-mini
# SESSION_QA_AGENT_TEMPERATURE=0.7

# JWT authentication (required for /auth endpoints)
JWT_SECRET=your-secret-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
