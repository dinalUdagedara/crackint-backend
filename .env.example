# Crackint Backend — copy to .env and adjust

# App
APP_NAME=Crackint Backend API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# NER model directory (folder containing bert_bilstm_crf_state.pt, ner_config.json, vocab.txt, etc.)
# Leave unset to use rule-based NAME/EMAIL only (no model). See RESUME_NER_SETUP.md.
RESUME_NER_LOAD_DIR=./model/resume_ner

# Upload limit for resume PDFs (MB)
MAX_UPLOAD_SIZE_MB=10
