# Crackint Backend — production .env for the Oracle VM (used by docker-compose.prod.yml)
# Copy to `.env` on the server and fill in real values. Never commit this file.

APP_NAME=Crackint Backend API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Restrict to your real frontend origin(s) in production.
CORS_ORIGINS=https://dinaludagedara.com,https://www.dinaludagedara.com

# NER models — baked into the Docker image from ./model (see .gitignore note), no download needed.
RESUME_NER_LOAD_DIR=./model/resume_ner
JOB_POSTER_NER_LOAD_DIR=./model/job_poster_ner

# Database — DATABASE_HOST is overridden to "postgres" by docker-compose.prod.yml, but
# DATABASE_NAME/USER/PASSWORD here are what seeds the postgres container itself, so they
# must be set here regardless.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=crackint_db
DATABASE_USER=crackint
DATABASE_PASSWORD=change-me-to-a-strong-password

# Upload limit for resume/job PDFs (MB)
MAX_UPLOAD_SIZE_MB=10

# AI agents (OpenAI) — same behavior as before, still pay-per-use via OpenAI billing, not AWS.
OPENAI_API_KEY=sk-...
RESUME_ENTITY_AGENT_ENABLED=false
JOB_ENTITY_AGENT_ENABLED=false
SESSION_QA_AGENT_ENABLED=true
SESSION_QA_AGENT_MODEL=gpt-4o-mini
SESSION_QA_AGENT_TEMPERATURE=0.7
CV_SCORING_ENABLED=true
CV_SCORING_MODEL=gpt-4o-mini
RESUME_JOB_FIT_LLM_ENABLED=false
COVER_LETTER_AGENT_ENABLED=true
COVER_LETTER_AGENT_MODEL=gpt-4o-mini
COVER_LETTER_AGENT_TEMPERATURE=0.7

# JWT authentication
JWT_SECRET=generate-a-real-32+-char-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth (same client ID as the frontend NextAuth Google provider)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AWS — kept only for S3 uploads + Transcribe STT (pay-per-use, NOT the source of the old bill).
# The old bill came from ECS/Fargate + RDS + ALB + NAT Gateway running 24/7 — none of those are used anymore.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
S3_UPLOADS_BUCKET=your-bucket-name
S3_UPLOADS_REGION=us-east-1
MAX_COVER_IMAGE_SIZE_MB=5
